<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.18.xsd" objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1743923367853-1" author="claudiomerli">
        <createTable tableName="customer_monitor">
            <column autoIncrement="true" name="id" type="INT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_customermonitor"/>
            </column>
            <column name="customer_id" type="INT"/>
            <column name="project_id" type="INT"/>
            <column name="status" type="VARCHAR(255)"/>
            <column name="currently_month_status" type="VARCHAR(255)"/>
            <column name="last_work" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet id="1743923367853-2" author="claudiomerli">
        <createTable tableName="message">
            <column autoIncrement="true" name="id" type="INT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_message"/>
            </column>
            <column name="message" type="VARCHAR(255)"/>
            <column name="source_role" type="VARCHAR(255)"/>
            <column name="source_user_id" type="INT"/>
            <column name="target_role" type="VARCHAR(255)"/>
            <column name="target_user_id" type="INT"/>
            <column name="timestamp" type="DATETIME"/>
            <column name="read" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1743923367853-17" author="claudiomerli">
        <addForeignKeyConstraint baseColumnNames="customer_id" baseTableName="customer_monitor" constraintName="FK_CUSTOMERMONITOR_ON_CUSTOMER" referencedColumnNames="id" referencedTableName="user"/>
    </changeSet>
    <changeSet id="1743923367853-18" author="claudiomerli">
        <addForeignKeyConstraint baseColumnNames="project_id" baseTableName="customer_monitor" constraintName="FK_CUSTOMERMONITOR_ON_PROJECT" referencedColumnNames="id" referencedTableName="project"/>
    </changeSet>
    <changeSet id="1743923367853-19" author="claudiomerli">
        <addForeignKeyConstraint baseColumnNames="source_user_id" baseTableName="message" constraintName="FK_MESSAGE_ON_SOURCEUSER" referencedColumnNames="id" referencedTableName="user"/>
    </changeSet>
    <changeSet id="1743923367853-20" author="claudiomerli">
        <addForeignKeyConstraint baseColumnNames="target_user_id" baseTableName="message" constraintName="FK_MESSAGE_ON_TARGETUSER" referencedColumnNames="id" referencedTableName="user"/>
    </changeSet>

</databaseChangeLog>
